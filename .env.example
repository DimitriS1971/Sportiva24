# Primary football provider (free-first)
FOOTBALL_DATA_API_TOKEN=

# Optional paid enhancer (leave empty for free mode)
APIFOOTBALL_API_KEY=
APIFOOTBALL_BASE_URL=https://v3.football.api-sports.io

# Public sport visibility controls (comma-separated SportCode values)
# Supported: football,basketball,tennis,formula1,cycling,baseball,esports
NEXT_PUBLIC_ACTIVE_SPORTS=football,basketball,baseball

# Free mode quality controls
# true = hide minor/noisy competitions and keep only top competitions in football cards
NEXT_PUBLIC_TOP_LEAGUES_ONLY=true
# true = strict mode (hides mock data in match lists)
NEXT_PUBLIC_FREE_STRICT_MODE=false

# Optional providers for next integration phases
BALLDONTLIE_API_KEY=
PANDASCORE_API_TOKEN=
THESPORTSDB_API_KEY=
MLB_API_BASE_URL=https://statsapi.mlb.com/api/v1

# Data platform controls
DATA_CACHE_TTL_SECONDS=300
DATA_PROVIDER_TIMEOUT_MS=6000
DATA_DEBUG_LOGS=false
